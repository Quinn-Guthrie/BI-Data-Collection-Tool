// Multi-Segment Sales App Database Schema
// Supports: Brewing, Bakery, Fresh Dairy, Cheese

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// BUSINESS SEGMENTS (NEW)
// ============================================

model BusinessSegment {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String   @default("#3b82f6")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userSegments     UserSegment[]
  cycles           Cycle[]
  entries          Entry[]
  enzymeCategories EnzymeCategory[]
  segments         Segment[]

  @@index([slug])
  @@index([active])
}

// ============================================
// USER-SEGMENT RELATIONSHIP (NEW)
// ============================================

model UserSegment {
  id         String      @id @default(cuid())
  userId     String
  segmentId  String
  role       SegmentRole @default(account_manager)
  assignedAt DateTime    @default(now())
  assignedBy String?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment BusinessSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([userId, segmentId])
  @@index([userId])
  @@index([segmentId])
}

enum SegmentRole {
  account_manager
  segment_admin
}

// ============================================
// USERS (UPDATED)
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(account_manager)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userSegments    UserSegment[]
  entries         Entry[]
  createdCycles   Cycle[]
  auditLogs       AuditLog[]
  approvedEntries EntryApproval[]

  @@index([role])
  @@index([active])
}

enum UserRole {
  super_admin
  account_manager
}

// ============================================
// REPORTING CYCLES (UPDATED)
// ============================================

model Cycle {
  id        String      @id @default(cuid())
  segmentId String
  name      String
  status    CycleStatus @default(open)
  openedAt  DateTime    @default(now())
  lockedAt  DateTime?
  createdBy String

  segment BusinessSegment @relation(fields: [segmentId], references: [id])
  creator User            @relation(fields: [createdBy], references: [id])
  entries Entry[]

  @@index([segmentId])
  @@index([status])
  @@index([createdBy])
}

enum CycleStatus {
  open
  locked
}

// ============================================
// LOOKUPS
// ============================================

model Company {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  entries Entry[]

  @@index([active])
}

model Country {
  id          String   @id @default(cuid())
  countryName String   @unique
  subregion   String
  region      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  entries Entry[]
  plants  Plant[]

  @@index([active])
}

model Plant {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  countryId String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  country Country @relation(fields: [countryId], references: [id])
  entries Entry[]

  @@index([countryId])
  @@index([active])
}

model Segment {
  id                String   @id @default(cuid())
  businessSegmentId String
  name              String
  definition        String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  businessSegment BusinessSegment @relation(fields: [businessSegmentId], references: [id])
  entries         Entry[]

  @@unique([businessSegmentId, name])
  @@index([businessSegmentId])
  @@index([active])
}

model Distributor {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  entries Entry[]

  @@index([active])
}

model EnzymeCategory {
  id                String   @id @default(cuid())
  businessSegmentId String?
  name              String
  productReference  String?
  helperText        String?
  sortOrder         Int
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  businessSegment BusinessSegment? @relation(fields: [businessSegmentId], references: [id])
  enzymeValues    EntryEnzymeValue[]

  @@unique([businessSegmentId, name])
  @@index([businessSegmentId])
  @@index([sortOrder])
  @@index([active])
}

// ============================================
// ENTRIES (UPDATED)
// ============================================

model Entry {
  id                     String         @id @default(cuid())
  businessSegmentId      String
  cycleId                String
  sourceEntryId          String?
  accountManagerUserId   String
  plantId                String?
  companyId              String
  subregion              String
  region                 String
  countryId              String
  existingCustomer       String
  goToMarket             String
  distributorId          String?
  productionBeerHlYear   Float?
  segmentId              String
  productionPercent      Float?
  confidencePercent      Float?
  comments               String?
  rejectionReason        String?
  status                 EntryStatus    @default(draft)
  finalized              Boolean        @default(false)
  approvalStatus         ApprovalStatus @default(pending)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  finalizedAt            DateTime?
  submittedForApprovalAt DateTime?
  reviewedBy             String?
  reviewedAt             DateTime?

  businessSegment  BusinessSegment    @relation(fields: [businessSegmentId], references: [id])
  cycle            Cycle              @relation(fields: [cycleId], references: [id])
  accountManager   User               @relation(fields: [accountManagerUserId], references: [id])
  plant            Plant?             @relation(fields: [plantId], references: [id])
  company          Company            @relation(fields: [companyId], references: [id])
  country          Country            @relation(fields: [countryId], references: [id])
  segment          Segment            @relation(fields: [segmentId], references: [id])
  distributor      Distributor?       @relation(fields: [distributorId], references: [id])
  enzymeValues     EntryEnzymeValue[]
  approvals        EntryApproval[]
  sourceEntry      Entry?             @relation("CarryForward", fields: [sourceEntryId], references: [id], onDelete: SetNull)
  carriedToEntries Entry[]            @relation("CarryForward")

  @@unique([cycleId, businessSegmentId, companyId, countryId, segmentId, plantId])
  @@index([businessSegmentId])
  @@index([status])
  @@index([approvalStatus])
  @@index([accountManagerUserId])
  @@index([cycleId])
}

enum ApprovalStatus {
  pending
  submitted
  approved
  rejected
}

enum EntryStatus {
  not_started
  carried_over_unconfirmed
  draft
  needs_correction
  ready_for_review
  finalized
  locked
}

// ============================================
// ENTRY DETAILS
// ============================================

model EntryEnzymeValue {
  id                          String  @id @default(cuid())
  entryId                     String
  enzymeCategoryId            String
  usageStatus                 String?
  penetrationPercent          Float?
  iffMarketSharePercent       Float?
  novonesisMarketSharePercent Float?
  dsmMarketSharePercent       Float?
  othersMarketSharePercent    Float?
  confirmed                   Boolean @default(false)
  comments                    String?

  entry          Entry          @relation(fields: [entryId], references: [id], onDelete: Cascade)
  enzymeCategory EnzymeCategory @relation(fields: [enzymeCategoryId], references: [id])

  @@unique([entryId, enzymeCategoryId])
  @@index([entryId])
}

model EntryApproval {
  id         String         @id @default(cuid())
  entryId    String
  approvedBy String
  status     ApprovalStatus
  comments   String?
  approvedAt DateTime       @default(now())

  entry    Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  approver User  @relation(fields: [approvedBy], references: [id])

  @@index([entryId])
  @@index([approvedBy])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  changedBy  String
  changedAt  DateTime @default(now())
  fieldName  String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [changedBy], references: [id])

  @@index([entityType, entityId])
  @@index([changedAt])
  @@index([changedBy])
}
